FILE_TYPE=LIBRARY_PARTS;
primitive 'USB_CON';
  pin
    'A2':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'A4':
      PIN_NUMBER='(4)';
      INPUT_LOAD='(-0.01,0.01)';
    'A3':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'A1':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'A5':
      PIN_NUMBER='(5)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'A6':
      PIN_NUMBER='(6)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='USB_CON';
    BODY_NAME='USB_CON';
    PHYS_DES_PREFIX='J';
    CLASS='IO';
  end_body;
end_primitive;

END.
