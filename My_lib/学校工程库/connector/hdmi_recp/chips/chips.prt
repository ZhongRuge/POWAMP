FILE_TYPE=LIBRARY_PARTS;
primitive 'HDMI_RECP';
  pin
    'TMDS_CLK+':
      PIN_NUMBER='(10)';
      INPUT_LOAD='(-0.01,0.01)';
    'TMDS_D0-':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'TMDS_CLK-':
      PIN_NUMBER='(12)';
      INPUT_LOAD='(-0.01,0.01)';
    'DDC_CLK':
      PIN_NUMBER='(15)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'DDC_DATA':
      PIN_NUMBER='(16)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'TMDS_D1-':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'TMDS_D1+':
      PIN_NUMBER='(4)';
      INPUT_LOAD='(-0.01,0.01)';
    'TMDS_D2+':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'TMDS_D2-':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'TMDS_D0+':
      PIN_NUMBER='(7)';
      INPUT_LOAD='(-0.01,0.01)';
    'D1_SHEILD':
      PIN_NUMBER='(5)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'D2_SHEILD':
      PIN_NUMBER='(2)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'CEC':
      PIN_NUMBER='(13)';
      INPUT_LOAD='(-0.01,0.01)';
    'CLK_SHEILD':
      PIN_NUMBER='(11)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'D0_SHEILD':
      PIN_NUMBER='(8)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'GND':
      PIN_NUMBER='(17)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'NC':
      PIN_NUMBER='(14)';
      PINUSE='NC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'PWR_5V':
      PIN_NUMBER='(18)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'HPD':
      PIN_NUMBER='(19)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    BODY_NAME='HDMI_RECP';
    PART_NAME='HDMI_RECP';
    JEDEC_TYPE='HDMI_socket';
    PHYS_DES_PREFIX='XS';
    CLASS='IO';
  end_body;
end_primitive;

END.
