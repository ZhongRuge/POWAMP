FILE_TYPE=LIBRARY_PARTS;
primitive 'ADS7883';
  pin
    'VDD':
      PIN_NUMBER='(1)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'GND':
      PIN_NUMBER='(2)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VIN':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'SCLK':
      PIN_NUMBER='(4)';
      INPUT_LOAD='(-0.01,0.01)';
    'SDO':
      PIN_NUMBER='(5)';
      OUTPUT_LOAD='(1.0,-1.0)';
    '-CS':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
  end_pin;
  body
    BODY_NAME='ADS7883';
    PART_NAME='ADS7883';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
