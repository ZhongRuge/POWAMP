FILE_TYPE=LIBRARY_PARTS;
primitive 'MAX485';
  pin
    '-RE':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'RO':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'DE':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'DI':
      PIN_NUMBER='(4)';
      INPUT_LOAD='(-0.01,0.01)';
    '-B':
      PIN_NUMBER='(7)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'A':
      PIN_NUMBER='(6)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'GND':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'VCC':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='MAX485';
    BODY_NAME='MAX485';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
