FILE_TYPE=LIBRARY_PARTS;
primitive '74HC00';
  pin
    'A':
      PIN_NUMBER='(1,4,9,12)';
      INPUT_LOAD='(-0.010000,0.010000)';
    'B':
      PIN_NUMBER='(2,5,10,13)';
      INPUT_LOAD='(-0.010000,0.010000)';
    '-Y':
      PIN_NUMBER='(3,6,8,11)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'GND':
      PIN_NUMBER='(7,7,7,7)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VCC':
      PIN_NUMBER='(14,14,14,14)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='74HC00';
    BODY_NAME='74HC00';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
