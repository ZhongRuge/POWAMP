FILE_TYPE=LIBRARY_PARTS;
primitive '74LVC1G32';
  pin
    'A':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'B':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'Y':
      PIN_NUMBER='(4)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'GND':
      PIN_NUMBER='(3)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'VCC':
      PIN_NUMBER='(5)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='74LVC1G32';
    BODY_NAME='74LVC1G32';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
