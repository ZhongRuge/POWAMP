      OUTPUT_LOAD='(1.0,-1.0)';
    'Y'<2>:
      PIN_NUMBER='(13)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'Y'<1>:
      PIN_NUMBER='(14)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'Y'<0>:
      PIN_NUMBER='(15)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    PART_NAME='74LVC138';
    BODY_NAME='74LVC138';
