      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'G1':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
