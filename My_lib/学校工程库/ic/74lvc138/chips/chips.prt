FILE_TYPE=LIBRARY_PARTS;
primitive '74LVC138';
  pin
    'A':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'B':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'C':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
