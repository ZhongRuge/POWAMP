FILE_TYPE=LIBRARY_PARTS;
primitive 'DAC7311';
  pin
    '-SYNC':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'SCLK':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'DIN':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'AVDD/VREF':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'GND':
      PIN_NUMBER='(5)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VOUT':
      PIN_NUMBER='(6)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    BODY_NAME='DAC7311';
    PART_NAME='DAC7311';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
