FILE_TYPE=LIBRARY_PARTS;
primitive 'ADM3202';
  pin
    'C1+':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'C1-':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'C2+':
      PIN_NUMBER='(4)';
      INPUT_LOAD='(-0.01,0.01)';
    'C2-':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'T1IN':
      PIN_NUMBER='(11)';
      INPUT_LOAD='(-0.01,0.01)';
    'T2IN':
      PIN_NUMBER='(10)';
      INPUT_LOAD='(-0.01,0.01)';
    'R1OUT':
      PIN_NUMBER='(12)';
      INPUT_LOAD='(-0.01,0.01)';
    'R2OUT':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'R1IN':
      PIN_NUMBER='(13)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'R2IN':
      PIN_NUMBER='(8)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'T1OUT':
      PIN_NUMBER='(14)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'T2OUT':
      PIN_NUMBER='(7)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'V-':
      PIN_NUMBER='(6)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'V+':
      PIN_NUMBER='(2)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'GND':
      PIN_NUMBER='(15)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'VCC':
      PIN_NUMBER='(16)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='ADM3202';
    BODY_NAME='ADM3202';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
