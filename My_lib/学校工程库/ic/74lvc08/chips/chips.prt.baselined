FILE_TYPE=LIBRARY_PARTS;
primitive '74LVC08';
  pin
    'Y':
      PIN_NUMBER='(3,6,8,11)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'B':
      PIN_NUMBER='(2,5,10,13)';
      INPUT_LOAD='(-0.01,0.01)';
    'A':
      PIN_NUMBER='(1,4,9,12)';
      INPUT_LOAD='(-0.01,0.01)';
    'VCC':
      PIN_NUMBER='(14,14,14,14)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'GND':
      PIN_NUMBER='(7,7,7,7)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='74LVC08';
    BODY_NAME='74LVC08';
    JEDEC_TYPE='TSSOP14';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
