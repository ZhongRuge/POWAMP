FILE_TYPE=LIBRARY_PARTS;
primitive 'OPA2211';
  pin
    'IN+':
      PIN_NUMBER='(3,5)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN-':
      PIN_NUMBER='(2,6)';
      INPUT_LOAD='(-0.01,0.01)';
    'OUT':
      PIN_NUMBER='(1,7)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'V-':
      PIN_NUMBER='(4,4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'V+':
      PIN_NUMBER='(8,8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'EX':
      PIN_NUMBER='(9,9)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='OPA2211';
    BODY_NAME='OPA2211';
    JEDEC_TYPE='SO-8';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
    CDS_LMAN_UNMAPPED_PHYS_PIN='(10,11,12,13,14)';
  end_body;
end_primitive;

END.
