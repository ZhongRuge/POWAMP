FILE_TYPE=LIBRARY_PARTS;
primitive 'OPA211';
  pin
    'IN+':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN-':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'OUT':
      PIN_NUMBER='(6)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'V-':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'V+':
      PIN_NUMBER='(7)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='OPA211';
    BODY_NAME='OPA211';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
    NC_PINS='(1,5,8)';
  end_body;
end_primitive;

END.
