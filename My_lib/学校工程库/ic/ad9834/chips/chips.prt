      INPUT_LOAD='(-0.01,0.01)';
    'FSELECT':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'PSELECT':
      PIN_NUMBER='(10)';
      INPUT_LOAD='(-0.01,0.01)';
    'RESET':
      PIN_NUMBER='(11)';
      INPUT_LOAD='(-0.01,0.01)';
    'SLEEP':
