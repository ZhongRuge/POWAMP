      INPUT_LOAD='(-0.01,0.01)';
    'SDATA':
      PIN_NUMBER='(13)';
      INPUT_LOAD='(-0.01,0.01)';
    'SCLK':
      PIN_NUMBER='(14)';
      INPUT_LOAD='(-0.01,0.01)';
    'FSYNC':
      PIN_NUMBER='(15)';
      INPUT_LOAD='(-0.01,0.01)';
    'SIGN BIT OUT':
      PIN_NUMBER='(16)';
