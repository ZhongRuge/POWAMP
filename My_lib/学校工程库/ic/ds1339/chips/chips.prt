FILE_TYPE=LIBRARY_PARTS;
primitive 'DS1339';
  pin
    'GND':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'VBKP':
      PIN_NUMBER='(3)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'X2':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'X1':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'VCC':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'SQW/INT':
      PIN_NUMBER='(7)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'SDA':
      PIN_NUMBER='(5)';
      OUTPUT_TYPE='(TS,TS)';
      BIDIRECTIONAL='TRUE';
      INPUT_LOAD='(-0.01,0.01)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'SCL':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
  end_pin;
  body
    PART_NAME='DS1339';
    BODY_NAME='DS1339';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
