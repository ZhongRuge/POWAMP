FILE_TYPE=LIBRARY_PARTS;
primitive 'DAC8551';
  pin
    'VDD':
      PIN_NUMBER='(1)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VREF':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'VFB':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'VOUT':
      PIN_NUMBER='(4)';
      OUTPUT_LOAD='(1.0,-1.0)';
    '-SYNC':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'SCLK':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'DIN':
      PIN_NUMBER='(7)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND':
      PIN_NUMBER='(8)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    BODY_NAME='DAC8551';
    PART_NAME='DAC8551';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
