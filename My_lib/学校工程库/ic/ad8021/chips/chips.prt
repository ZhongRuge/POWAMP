FILE_TYPE=LIBRARY_PARTS;
primitive 'AD8021';
  pin
    'LOGIC REF':
      PIN_NUMBER='(1)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'IN-':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN+':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'VS-':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'COMP':
      PIN_NUMBER='(5)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VOUT':
      PIN_NUMBER='(6)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VS+':
      PIN_NUMBER='(7)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    '-DISABLE':
      PIN_NUMBER='(8)';
      INPUT_LOAD='(-0.01,0.01)';
  end_pin;
  body
    BODY_NAME='AD8021';
    PART_NAME='AD8021';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
