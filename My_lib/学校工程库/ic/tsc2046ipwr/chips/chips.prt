FILE_TYPE=LIBRARY_PARTS;
primitive 'TSC2046IPWR';
  pin
    'VBAT':
      PIN_NUMBER='(7)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    '+VCC':
      PIN_NUMBER='(1)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'X+':
      PIN_NUMBER='(2)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'X-':
      PIN_NUMBER='(4)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'Y+':
      PIN_NUMBER='(3)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'Y-':
      PIN_NUMBER='(5)';
      OUTPUT_LOAD='(1.0,-1.0)';
    '-PENIRQ':
      PIN_NUMBER='(11)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'BUSY':
      PIN_NUMBER='(13)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'GND':
      PIN_NUMBER='(6)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    '-CS':
      PIN_NUMBER='(15)';
      INPUT_LOAD='(-0.01,0.01)';
    'DIN':
      PIN_NUMBER='(14)';
      INPUT_LOAD='(-0.01,0.01)';
    'DCLK':
      PIN_NUMBER='(16)';
      INPUT_LOAD='(-0.01,0.01)';
    'DOUT':
      PIN_NUMBER='(12)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VREF':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'AUX':
      PIN_NUMBER='(8)';
      INPUT_LOAD='(-0.01,0.01)';
    'IOVDD':
      PIN_NUMBER='(10)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='TSC2046IPWR';
    BODY_NAME='TSC2046IPWR';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
