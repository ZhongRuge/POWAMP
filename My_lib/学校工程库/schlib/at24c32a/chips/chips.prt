FILE_TYPE=LIBRARY_PARTS;
primitive 'AT24C32A';
  pin
    'A0':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'A1':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'A2':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND':
      PIN_NUMBER='(4)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VCC':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'WP':
      PIN_NUMBER='(7)';
      PINUSE='UNSPEC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'SCL':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'SDA':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
  end_pin;
  body
    PART_NAME='AT24C32A';
    BODY_NAME='AT24C32A';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
