FILE_TYPE=LIBRARY_PARTS;
primitive 'DS1388';
  pin
    'X1':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'X2':
      PIN_NUMBER='(2)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VBAT':
      PIN_NUMBER='(3)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'GND':
      PIN_NUMBER='(4)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VCC':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    '-RST':
      PIN_NUMBER='(7)';
      INPUT_LOAD='(-0.01,0.01)';
    'SCL':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'SDA':
      PIN_NUMBER='(5)';
      BIDIRECTIONAL='TRUE';
      INPUT_LOAD='(-0.01,0.01)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    PART_NUMBER='DS1388';
    VENDOR='MAXIM';
    BODY_NAME='DS1388';
    PART_NAME='DS1388';
    JEDEC_TYPE='SOP8-50-150';
    PHYS_DES_PREFIX='U';
    CLASS='IC';
  end_body;
end_primitive;

END.
