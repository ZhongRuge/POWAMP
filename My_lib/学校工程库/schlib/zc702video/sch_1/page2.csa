FILE_TYPE = MACRO_DRAWING;
SET COLOR_WIRE YELLOW;
SET COLOR_PROP ORANGE;
SET COLOR_DOT WHITE;
SET COLOR_ARC YELLOW;
SET COLOR_BODY GREEN;
SET COLOR_NOTE PURPLE;
SET PROP_DISPLAY VALUE;
SET PAGE_NUMBER P2;
FORCEADD MT41J128M16..1
(-4050 3650);
FORCEPROP 1 LAST CDS_LMAN_SYM_OUTLINE -125,1300,125,-1300
J 0
(-4050 3650);
DISPLAY 0.468085 (-4050 3650);
PAINT GREEN (-4050 3650);
DISPLAY INVISIBLE (-4050 3650);
FORCEPROP 2 LAST PATH I1
J 0
(-3750 5100);
FORCEPROP 2 LAST CDS_LIB ic
J 0
(-4050 3650);
DISPLAY INVISIBLE (-4050 3650);
FORCEADD B SIZE PAGE..1
(2900 400);
FORCEPROP 2 LAST CDS_LIB standard
J 0
(2900 400);
DISPLAY INVISIBLE (2900 400);
FORCEPROP 1 LAST COMMENT_BODY TRUE
J 0
(1075 325);
DISPLAY 0.872340 (1075 325);
PAINT GREEN (1075 325);
DISPLAY INVISIBLE (1075 325);
QUIT
