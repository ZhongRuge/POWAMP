FILE_TYPE=LIBRARY_PARTS;
primitive 'H1102';
  pin
    'TD+':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'TCT':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'TD-':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'RD+':
      PIN_NUMBER='(6)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'RCT':
      PIN_NUMBER='(7)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'RD-':
      PIN_NUMBER='(8)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'TX+':
      PIN_NUMBER='(16)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'TCMT':
      PIN_NUMBER='(15)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'TX-':
      PIN_NUMBER='(14)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'RX+':
      PIN_NUMBER='(11)';
      INPUT_LOAD='(-0.01,0.01)';
    'RCMT':
      PIN_NUMBER='(10)';
      INPUT_LOAD='(-0.01,0.01)';
    'RX-':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'NC'<4..1>:
